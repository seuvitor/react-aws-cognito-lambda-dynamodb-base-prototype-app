{
  "name": "react-aws-cognito-lambda-dynamodb-base-prototype-app",
  "version": "1.4.1",
  "description": "Base components for prototyping a serverless React app making use of AWS Cognito, Lambda and DynamoDB",
  "license": "MIT",
  "author": "Vitor Dantas",
  "repository": {
    "type": "git",
    "url": "https://github.com/seuvitor/react-aws-cognito-lambda-dynamodb-base-prototype-app.git"
  },
  "files": [
    "dist/*",
    "src"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && vite build && tsc -p tsconfig.build.json",
    "start": "vite dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-docdb": "^3.972.64",
    "@aws-sdk/client-dynamodb": "^3.972.64",
    "@aws-sdk/client-lambda": "^3.972.64",
    "@aws-sdk/credential-provider-cognito-identity": "^3.972.64",
    "@aws-sdk/lib-dynamodb": "^3.972.64",
    "@aws-sdk/util-dynamodb": "^3.972.64",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  }
}
